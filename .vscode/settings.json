{
  // bun.lock dung dinh dang JSONC cua Bun (cho phep dau phay cuoi dong),
  // nen bao VS Code dung canh bao "Trailing comma" cho file nay.
  "files.associations": {
    "bun.lock": "jsonc"
  },
  "json.schemas": [
    {
      "fileMatch": ["bun.lock"],
      "schema": {
        "allowTrailingCommas": true
      }
    }
  ]
}
